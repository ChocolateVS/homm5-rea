<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: 2dog packages come from there, and machine-level private feeds must not break restores. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
